# Copy to .env.local (local) or set in your hosting dashboard (production). See docs/ENVIRONMENT.md.

# Public site URL — used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). The URL and anon key are safe for the browser; they only allow
# read-only access to catalogue data because Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never commit, never expose.
# Used for creating orders and for the staff admin dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Mock catalogue for LOCAL DEVELOPMENT ONLY. Leave unset in production. When "true" the site shows the built-in sample
# products and takes orders without saving them. Without it, missing Supabase settings show an "unavailable" page.
# ALLOW_DEMO_DATA=true
